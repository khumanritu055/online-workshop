      <h2>SkillUp Workshops</h2>
      <p>
        SkillUp Workshops delivers expert-led training, hands-on practical sessions,
        and industry-focused learning programs.
        Our mission is to empower students with real-world skills.
      </p>
    </div>

    <!-- Column 2 -->
    <div class="footer-col">
      <h3>Quick Links</h3>
      <ul>
        <li><a href="#">Home</a></li>
        <li><a href="#">Workshops</a></li>
        <li><a href="#">About Us</a></li>
        <li><a href="#">Contact</a></li>
      </ul>
    </div>

    <!-- Column 3 -->
    <div class="footer-col">
      <h3>Contact Info</h3>
      <p>Email: skillup@email.com</p>
      <p>Phone: +91 98765 43210</p>
      <p>Location: India</p>
    </div>

    <!-- Column 4 Newsletter -->
