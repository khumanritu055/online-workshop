      <span>01</span>
      <p>Register for Workshop</p>
    </div>
    <div class="step">
      <span>02</span>
      <p>Attend Live Session</p>
    </div>
    <div class="step">
      <span>03</span>
      <p>Hands-on Practice</p>
    </div>
    <div class="step">
      <span>04</span>
      <p>Get Certificate</p>
    </div>
  </div>
</section>

<!-- ===== COLOR INFO BANNER ===== -->
<section class="info-banner">
  <h2>Learn • Build • Grow</h2>
  <p>
    SkillUp Workshops are designed to transform learners into confident
    professionals through practical, guided and engaging learning experiences.
  </p>
</section>



<!-- Footer -->

<footer class="footer">

