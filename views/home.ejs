      <form class="newsletter">
        <input type="email" placeholder="Enter your email">
        <button type="submit">Subscribe</button>
      </form>
    </div>

  </div>



  <!-- Bottom Line -->
  <div class="footer-bottom">
    <p>© 2026 SkillUp Workshops | Designed & Developed by <strong>Ritu Khuman</strong></p>
  </div>

</footer>




</body>
</html>
